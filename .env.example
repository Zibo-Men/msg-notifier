# hub 对外端口（工作电脑访问 http://192.168.0.119:8101）
HUB_PORT=8101
# 工作电脑调用 hub 的令牌，随机长字符串；工作电脑 config.json 的 hub_token 要填同一个
HUB_TOKEN=
# Bark：服务器地址和设备 key（Bark App 首页 URL 里 api.day.app/ 后面那段）；多个设备用逗号分隔
BARK_SERVER=https://api.day.app
BARK_KEY=
# 日志 / 推送记录保留天数
LOG_KEEP_DAYS=30
EVENT_KEEP_DAYS=180
# 容器日志时区
TZ=America/Los_Angeles
