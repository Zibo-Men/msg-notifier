# noVNC 对外端口（手动登录用）
NOVNC_PORT=8101
# noVNC/VNC 密码（必填，VNC 协议只取前 8 位）
VNC_PASSWORD=change-me

# Bark：iPhone 上 Bark App 里复制的 key；也可换成自建 bark-server 地址
BARK_SERVER=https://api.day.app
BARK_KEY=
# 推送级别：active / timeSensitive / critical（critical 静音模式也会响）
BARK_LEVEL=timeSensitive
# 1 = 持续响铃约 30 秒（像来电）
BARK_CALL=0

# 启用的平台，逗号分隔：lark,teams,gmail
PLATFORMS=lark,teams,gmail
# 同一平台两次推送的最小间隔（秒），防止刷屏
MIN_INTERVAL=20
